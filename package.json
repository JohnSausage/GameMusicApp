{
  "name": "game-music-app",
  "productName": "GameMusicApp",
  "version": "0.2.0",
  "description": "Compose game music on guitar: record, transcribe to tab, arrange, export WAV/MIDI",
  "author": "JohnSausage",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "licenses": "node scripts/third-party-licenses.mjs",
    "smoke": "electron . --smoke-test --ozone-platform=headless --ozone-override-screen-size=1600,1000"
  },
  "devDependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^3.21.0",
    "@tonejs/midi": "^2.0.28",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "spessasynth_core": "^4.3.22",
    "spessasynth_lib": "^4.3.14",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "core-js": false,
    "electron-winstaller": false
  },
  "dependencies": {
    "wasm-media-encoders": "^0.7.0"
  }
}
